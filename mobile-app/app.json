{
  "expo": {
    "name": "Gatimaan",
    "slug": "gatimaan",
    "scheme": [
      "gatimaan",
      "trackflow"
    ],
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adesh.trackflow",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Gatimaan requires location access in the foreground to verify your punch-in/out range relative to the office geofence.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Gatimaan collects location data in the background to log your field route and verify compliance with office geofencing rules while you are punched in.",
        "NSLocationAlwaysUsageDescription": "Gatimaan collects location data in the background to log your field route and verify compliance with office geofencing rules while you are punched in.",
        "NSCameraUsageDescription": "Gatimaan requires camera access to capture attendance selfies and expense receipts.",
        "NSPhotoLibraryUsageDescription": "Gatimaan requires photo library access to upload profile pictures and expense receipts.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 4,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.adesh.trackflow",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "gatimaan",
    "updates": {
      "url": "https://u.expo.dev/27dda92e-6b43-424d-b808-8884c0047fb4",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000
    },
    "runtimeVersion": "1.0.3",
    "extra": {
      "eas": {
        "projectId": "27dda92e-6b43-424d-b808-8884c0047fb4"
      }
    }
  }
}